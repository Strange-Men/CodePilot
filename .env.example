PYTHON_VERSION=3.11.11
USE_MOCK_LLM=true
ENABLE_REAL_LLM=false
REVIEW_ENGINE=v3_multi_agent

# --- LLM Providers ---
# Mock mode (USE_MOCK_LLM=true) needs no real key.
# Real LLM mode uses backend-only provider credentials.
# Frontend stores provider choice only; it never stores API keys.
REAL_LLM_PROVIDER=mimo
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
MIMO_API_KEY=<your_mimo_api_key>
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
MIMO_MODEL_NAME=mimo-v2.5-pro
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL_NAME=your-volcengine-endpoint-id
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_NAME=deepseek-chat
DATABASE_PATH=backend/data/codepilot.db
WORKSPACE_PATH=backend/workspace
REPORTS_PATH=reports
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1):\d+
MAX_FILES=300
MAX_FILE_SIZE_BYTES=204800
LARGE_REPO_THRESHOLD=300
FINAL_PROMPT_TOKEN_BUDGET=5000
LLM_CONNECT_TIMEOUT_SECONDS=10
LLM_READ_TIMEOUT_SECONDS=180
LLM_WRITE_TIMEOUT_SECONDS=30
LLM_POOL_TIMEOUT_SECONDS=10
LLM_MAX_RETRIES=2
# separate = recommended default (4 independent LLM calls, V3.5.9)
# grouped = experimental only (2 grouped calls, V3.5.10 — failed first benchmark: 3x slower, 0 findings)
REVIEW_AGENT_MODE=separate
REVIEW_AGENT_CONCURRENCY=2
REVIEW_SPEED_MODE=balanced
ENABLE_LLM_TRANSLATION=false
LOCALIZATION_PROVIDER=auto
LOCALIZATION_MODEL=
NEXT_PUBLIC_API_BASE=http://localhost:8000
